# ============================================
# HALA'S CHOICES — Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# --- Supabase ---
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Admin Authentication ---
# Choose a strong password for the admin panel (/admin)
ADMIN_PASSWORD=your-secret-admin-password-here

# --- Optional: Hala's Welcome Password ---
# Set this if you want a simple password on the client side too.
# Leave empty or remove to disable.
HALA_PASSWORD=

# --- App URL (used for absolute redirects) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
